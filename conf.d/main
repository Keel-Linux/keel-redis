#!/bin/bash -ex
# Redis, and nothing that serves a web page.
#
# The conf script of the unit.d/redis component has already run (fab runs the
# units after the common conf scripts and before this one): it appended the
# include of /etc/redis/redis.conf.d to Debian's conffile, checked that the
# bind and ACL fragments arrived, started the server from that very file, and
# proved it answers INFO on [::1] and on 127.0.0.1 and refuses every key to a
# client with no secret.
#
# So what is left here is what a recipe owes: checking the component rather
# than trusting it, and the project's own packages.

# 1. The component's fragments are in the image, and say what they must say.
#    The component asserted the behaviour during its own run; this asserts
#    that the files it asserted are what the layer is about to ship, because
#    a removelist, an overlay of this recipe or a later conf script could
#    take one of them away and nothing else would notice.
grep -qx 'bind ::1 127.0.0.1' /etc/redis/redis.conf.d/10-keel-bind.conf
grep -qx 'user default on nopass +info' /etc/redis/redis.conf.d/20-keel-acl.conf

# Exactly one account is declared in the whole of /etc/redis, and it is not
# the administrative one. Redis refuses a user declared twice across
# configuration files ("Duplicate user found. A user can only be defined
# once in config files"), which is why the component publishes no
# administrative account and the first boot declares it once. A second
# declaration anywhere would be a layer whose Redis cannot start at all.
[[ $(cat /etc/redis/redis.conf.d/*.conf | grep -c '^user ') -eq 1 ]]
! grep -rqE '^user admin' /etc/redis/
grep -qxF 'include /etc/redis/redis.conf.d/*.conf' /etc/redis/redis.conf

# 2. No password anywhere, and no administrative account at all. The whole
#    point of the ACL account is that this layer is published with no usable
#    credential in it: a requirepass would be the same password on every
#    appliance built from this layer, and an account that is not declared
#    cannot authenticate until the first boot declares it from the instance
#    description.
! grep -rqE '^[[:space:]]*requirepass' /etc/redis/
! test -e /etc/redis/redis.conf.d/50-keel-secret.conf

# 3. No log file the service will not be able to write. Redis opens every
#    value its logfile setting is ever given, so anything that runs the
#    server as root during a build leaves /var/log/redis/redis-server.log
#    owned by root in a directory the redis user owns, and the service then
#    fails to start with "Can't open the log file: Permission denied" on
#    every machine built from the layer. The component's conf script takes
#    an empty one away; this is the check that it did.
if [ -e /var/log/redis/redis-server.log ]; then
    [[ $(stat -c %U /var/log/redis/redis-server.log) == redis ]]
fi

# 4. The client is installed, because the first boot hook and `keel inspect`
#    both run it. redis-server depends on it, so this is a check and not a
#    request.
dpkg-query -W -f '${Status}' redis-tools | grep -qx 'install ok installed'
dpkg-query -W -f '${Status}' redis-server | grep -qx 'install ok installed'

# 5. Debian 13 packages no Webmin module for Redis, which README.rst says out
#    loud rather than leaving a reader to look for the line. The check is
#    here so that the day one appears is the day somebody is told, rather
#    than a panel that could have had a Redis page and quietly does not.
if apt-cache show webmin-redis > /dev/null 2>&1; then
    echo "webmin-redis is in the archive now: add it to plan/main, check it" >&2
    echo "in this script and check it on the booted machine in the boot test" >&2
    exit 1
fi

# fab-plan-resolve keeps a package the parent layer already carries at the
# parent's version, so the two core packages are upgraded here from the
# build time source (keel, new in the plan, was installed from it already).
#
# The overlay of this layer ships /etc/confconsole/services.txt, which is a
# conffile of confconsole, so dpkg sees it as locally modified and asks what
# to do with it. The conf script runs with stdin closed, dpkg reads end of
# file at the prompt and leaves confconsole "install ok unpacked", which
# fails this script. Keep the overlay's file without asking.
#
# The build time archive has to win over every other source here: a
# bootstrap from before Keel-Linux/common#30 pins TurnKey's archive at 999.
# It used to win through the overlay's /etc/apt/preferences.d/keel at 1001,
# which then shipped in the image and downgraded every package newer than the
# archive's (tracker#23). This pin names the staging distribution by its
# Label, exists only during the build and goes with the build time source
# (conf.d/zz-project-packages).
printf 'Package: *\nPin: release l=Keel Linux staging\nPin-Priority: 1001\n' \
    > /etc/apt/preferences.d/keel-staging
export DEBIAN_FRONTEND=noninteractive
apt-get install -y --only-upgrade \
    -o Dpkg::Options::=--force-confdef \
    -o Dpkg::Options::=--force-confold \
    inithooks confconsole

# A half configured package keeps its new version, so check the state too.
[[ $(dpkg-query -W -f '${Status}\n' inithooks confconsole keel \
    | grep -c '^install ok installed$') -eq 3 ]]

# What is installed is then checked against the archive rather than against a
# literal version, which is conf.d/zz-project-packages, the last script of
# this build. A literal passes whenever the build happens to read a stale
# index, which is how the forum layer of 2026-09-26 shipped the previous
# morning's inithooks and confconsole with a green build (docs/traps.md).
#
# keel 0.3.5 is what this layer is published to carry: `keel inspect` reads
# database.server.role from INFO replication and INFO cluster there, which is
# what the boot test checks and what the console's cloud modes will be built
# on. A layer carrying keel 0.2.1 answers nothing for the database section
# and the boot test's inspect check fails, so the floor is here as well as in
# the archive check, because they fail for different reasons: this one says
# the version is too old, that one says the index was stale.
while read -r package floor; do
    installed=$(dpkg-query -W -f '${Version}' "$package")
    dpkg --compare-versions "$installed" ge "$floor" \
        || { echo "$package $installed is older than $floor" >&2; exit 1; }
done <<EOF
inithooks 2.3.6+keel4
confconsole 2.2.3+keel2
keel 0.3.5
EOF
dpkg-query -W -f '${Package} ${Version} ${Status}\n' inithooks confconsole keel
